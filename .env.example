# Public site origin used for canonical URLs, Open Graph, sitemap, and CMS OAuth.
# After Cloudflare deploy, set this to your real Pages URL (or custom domain).
PUBLIC_SITE_URL=https://pankaj-bg4.pages.dev

# GitHub repository that stores Markdown posts (owner/name).
PUBLIC_GITHUB_REPO=pankajchouhan0610/pankajchouhan0610.github.io

# Git branch Decap CMS commits to.
PUBLIC_GITHUB_BRANCH=main

# Optional override for /admin password at build time.
# Leave empty to use the built-in hash. Never commit the real password.
# ADMIN_PASSWORD=

# Required on Cloudflare Pages for live Decap GitHub login.
# Create at https://github.com/settings/developers (OAuth Apps).
# Callback URL must be: https://YOUR_DOMAIN/api/auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
