# Public site origin used for canonical URLs, Open Graph, sitemap, and CMS OAuth.
PUBLIC_SITE_URL=https://pankajchouhan0610.github.io

# GitHub repository that stores Markdown posts (owner/name).
PUBLIC_GITHUB_REPO=pankajchouhan0610/pankajchouhan0610.github.io

# Git branch Decap CMS commits to.
PUBLIC_GITHUB_BRANCH=main

# Keep this unset on GitHub Pages. The live /admin page stays locked.
# Set to true only if you host on Cloudflare Pages and have GitHub OAuth configured.
# PUBLIC_ENABLE_CMS=true

# Server-only GitHub OAuth credentials for /admin on Cloudflare Pages.
# Create a GitHub OAuth App; never commit the secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
