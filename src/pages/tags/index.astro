---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../consts';
import { getPublishedPosts, uniqueTags } from '../../lib/posts';
import { tagUrl } from '../../lib/urls';

const allPosts = await getPublishedPosts();
const tags = uniqueTags(allPosts);
---

<BaseLayout
  title={`Tags | ${SITE_NAME}`}
  description={`Browse all article tags on ${SITE_NAME}.`}
  posts={allPosts}
>
  <div class="mx-auto max-w-[720px] px-5 py-12 md:px-8">
    <h1 class="text-3xl font-bold tracking-tight">Tags</h1>
    <ul class="mt-8 flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <li>
            <a class="inline-flex bg-[var(--tag)] px-3 py-1.5 text-sm text-[var(--tag-text)] hover:text-[var(--ink)]" href={tagUrl(tag)}>
              {tag}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
