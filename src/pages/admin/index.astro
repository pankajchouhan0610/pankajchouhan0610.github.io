---
import { getAdminAuthConfig } from '../../lib/adminAuth';

export const prerender = true;

const auth = getAdminAuthConfig();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Admin | Pankaj</title>
    <style>
      :root {
        --page: #111111;
        --ink: #f4f4f4;
        --muted: #a3a3a3;
        --line: #2a2a2a;
        --accent: #e02424;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        background: var(--page);
        color: var(--ink);
      }
      .wrap {
        max-width: 22rem;
        margin: 18vh auto 0;
        padding: 0 1.25rem 3rem;
      }
      .brand {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin-bottom: 1.75rem;
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
        color: inherit;
      }
      .mark {
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        background: var(--accent);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 0.9rem;
      }
      h1 {
        font-size: 1.15rem;
        text-align: center;
        margin: 0 0 1.25rem;
      }
      label {
        display: block;
        font-size: 0.8rem;
        color: var(--muted);
        margin: 0.85rem 0 0.35rem;
      }
      input {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--ink);
        padding: 0.7rem 0.75rem;
        font: inherit;
      }
      button {
        width: 100%;
        margin-top: 1.15rem;
        border: 0;
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        padding: 0.75rem;
        cursor: pointer;
      }
      .error {
        text-align: center;
        color: #ff8a8a;
        font-size: 0.85rem;
        min-height: 1.3rem;
      }
      a {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main class="wrap" data-admin-login>
      <a class="brand" href="/">
        <img
          src="/images/pankaj.jpg"
          alt=""
          width="32"
          height="32"
          style="width:2rem;height:2rem;border-radius:999px;object-fit:cover"
        />
        Pankaj
      </a>
      <h1>Enter password</h1>
      <form data-admin-form>
        <label for="admin-pass">Password</label>
        <input
          id="admin-pass"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          autofocus
        />
        <p class="error" data-admin-error></p>
        <button type="submit">Unlock</button>
      </form>
    </main>

    <script is:inline define:vars={{ salt: auth.salt, credentialHash: auth.credentialHash }}>
      const STORAGE_KEY = 'pankaj:admin-auth';
      const MAX_AGE_MS = 8 * 60 * 60 * 1000;

      async function sha256Hex(value) {
        const bytes = new TextEncoder().encode(value);
        const digest = await crypto.subtle.digest('SHA-256', bytes);
        return Array.from(new Uint8Array(digest))
          .map((byte) => byte.toString(16).padStart(2, '0'))
          .join('');
      }

      function isUnlocked() {
        try {
          const raw = sessionStorage.getItem(STORAGE_KEY);
          if (!raw) return false;
          const parsed = JSON.parse(raw);
          return parsed.ok === true && Date.now() - parsed.at < MAX_AGE_MS;
        } catch {
          return false;
        }
      }

      function loadCms() {
        const login = document.querySelector('[data-admin-login]');
        login?.remove();
        const link = document.createElement('link');
        link.rel = 'cms-config-url';
        link.type = 'text/yaml';
        // Local Astro serves /admin/config.yml. Cloudflare serves /api/cms-config.
        const isLocal =
          location.hostname === 'localhost' || location.hostname === '127.0.0.1';
        link.href = isLocal ? '/admin/config.yml' : '/api/cms-config';
        document.head.appendChild(link);
        const script = document.createElement('script');
        script.src = 'https://unpkg.com/decap-cms@3.8.3/dist/decap-cms.js';
        // After Decap loads, register the Mermaid insert button for the markdown editor.
        script.onload = () => {
          const helper = document.createElement('script');
          helper.src = '/admin/mermaid-editor.js';
          document.body.appendChild(helper);
        };
        document.body.appendChild(script);
      }

      if (isUnlocked()) {
        loadCms();
      } else {
        document.querySelector('[data-admin-form]')?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const form = event.currentTarget;
          const error = document.querySelector('[data-admin-error]');
          const password = form.password.value;
          const hash = await sha256Hex(`${salt}:${password}`);
          if (hash !== credentialHash) {
            if (error) error.textContent = 'Wrong password.';
            return;
          }
          sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ ok: true, at: Date.now() }));
          loadCms();
        });
      }
    </script>
  </body>
</html>
