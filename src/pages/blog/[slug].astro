---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleMeta from '../../components/ArticleMeta.astro';
import TagList from '../../components/TagList.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import PrevNext from '../../components/PrevNext.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import MermaidDiagrams from '../../components/MermaidDiagrams.astro';
import { SITE_NAME } from '../../consts';
import {
  adjacentPosts,
  getPublishedPosts,
  relatedPosts as findRelated,
  type BlogPost,
} from '../../lib/posts';
import { readingTime } from '../../lib/readingTime';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import { FALLBACK_SITE_URL } from '../../consts';
import { canonicalFromPath, categoryUrl, postUrl } from '../../lib/urls';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const allPosts = await getPublishedPosts();
const { Content, headings } = await render(post);
const related = findRelated(post, allPosts);
const { newer, older } = adjacentPosts(post, allPosts);
const time = readingTime(post.body);
const site = Astro.site?.href ?? FALLBACK_SITE_URL;
const url = canonicalFromPath(postUrl(post.id), site);
const socialImage =
  post.data.heroImage && !post.data.heroImage.toLowerCase().endsWith('.svg')
    ? post.data.heroImage
    : '/images/og-default.png';
const image = new URL(socialImage, site).href;
---

<BaseLayout
  title={`${post.data.title} | ${SITE_NAME}`}
  description={post.data.description}
  type="article"
  image={post.data.heroImage}
  imageAlt={post.data.heroImageAlt ?? post.data.title}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  tags={post.data.tags}
  section={post.data.category}
  posts={allPosts}
  jsonLd={[
    articleJsonLd({
      site,
      url,
      title: post.data.title,
      description: post.data.description,
      image,
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      author: post.data.author,
      category: post.data.category,
      tags: post.data.tags,
    }),
    breadcrumbJsonLd(site, [
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: post.data.title, path: postUrl(post.id) },
    ]),
  ]}
>
  <article class="mx-auto max-w-[1080px] px-5 py-10 md:px-8">
    <header class="mx-auto max-w-[720px]">
      <a class="text-sm font-medium text-[var(--muted)] hover:text-[var(--accent)]" href={categoryUrl(post.data.category)}>
        {post.data.category}
      </a>
      <div class="mt-3 flex items-start justify-between gap-4">
        <h1 class="text-[2rem] font-bold leading-tight tracking-tight sm:text-[2.35rem]">
          {post.data.title}
        </h1>
        <BookmarkButton slug={post.id} />
      </div>
      <p class="mt-4 text-lg text-[var(--muted)]">{post.data.description}</p>
      <div class="mt-4">
        <ArticleMeta
          author={post.data.author}
          pubDate={post.data.pubDate}
          updatedDate={post.data.updatedDate}
          readingTime={time.label}
        />
      </div>
      <div class="mt-5">
        <TagList tags={post.data.tags} />
      </div>
    </header>

    {
      post.data.heroImage && (
        <figure class="mx-auto mt-8 max-w-[860px]">
          <img
            src={post.data.heroImage}
            alt={post.data.heroImageAlt ?? post.data.title}
            width="1200"
            height="800"
            class="aspect-[3/2] w-full object-cover"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="mx-auto mt-10 grid max-w-[960px] gap-10 lg:grid-cols-[220px_minmax(0,720px)]">
      <aside class="lg:sticky lg:top-8 lg:self-start">
        <TableOfContents headings={headings} />
      </aside>
      <div class="prose max-w-[720px]">
        <Content />
        <MermaidDiagrams />
      </div>
    </div>

    <div class="mx-auto max-w-[720px]">
      <RelatedPosts posts={related} />
      <PrevNext newer={newer} older={older} />
    </div>
  </article>
</BaseLayout>
