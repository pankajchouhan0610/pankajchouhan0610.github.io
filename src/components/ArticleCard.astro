---
import type { BlogPost } from '../lib/posts';
import { formatRelativeDate } from '../lib/dates';
import { postUrl } from '../lib/urls';
import ArticleMeta from './ArticleMeta.astro';
import BookmarkButton from './BookmarkButton.astro';
import TagList from './TagList.astro';

interface Props {
  post: BlogPost;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const href = postUrl(post.id);
const image = post.data.heroImage;
const alt = post.data.heroImageAlt ?? post.data.title;
---

<article class="border-b border-[var(--line)] py-8 first:pt-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-8">
    {
      image && (
        <a href={href} class="block w-full shrink-0 sm:w-[240px]">
          <img
            src={image}
            alt={alt}
            width="480"
            height="320"
            class="aspect-[3/2] w-full object-cover"
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
          />
        </a>
      )
    }
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-4">
        <h2 class="text-[1.45rem] font-bold leading-tight tracking-tight sm:text-[1.7rem]">
          <a href={href} class="text-[var(--ink)] no-underline hover:text-[var(--accent)]">
            {post.data.title}
          </a>
        </h2>
        <BookmarkButton slug={post.id} />
      </div>
      <div class="mt-2">
        <ArticleMeta
          author={post.data.author}
          pubDate={post.data.pubDate}
          relative={formatRelativeDate(post.data.pubDate)}
        />
      </div>
      <div class="mt-6">
        <TagList tags={post.data.tags} />
      </div>
    </div>
  </div>
</article>
