---
import type { BlogPost } from '../lib/posts';
import { postUrl } from '../lib/urls';

interface Props {
  newer?: BlogPost;
  older?: BlogPost;
}

const { newer, older } = Astro.props;
---

{
  (newer || older) && (
    <nav class="mt-12 grid gap-4 border-t border-[var(--line)] pt-8 sm:grid-cols-2" aria-label="Adjacent articles">
      {older ? (
        <a class="group rounded-sm border border-[var(--line)] p-4 hover:border-[var(--ink)]" href={postUrl(older.id)}>
          <p class="text-xs uppercase tracking-wide text-[var(--muted)]">Previous</p>
          <p class="mt-1 font-semibold group-hover:text-[var(--accent)]">{older.data.title}</p>
        </a>
      ) : (
        <span></span>
      )}
      {newer && (
        <a class="group rounded-sm border border-[var(--line)] p-4 text-right hover:border-[var(--ink)]" href={postUrl(newer.id)}>
          <p class="text-xs uppercase tracking-wide text-[var(--muted)]">Next</p>
          <p class="mt-1 font-semibold group-hover:text-[var(--accent)]">{newer.data.title}</p>
        </a>
      )}
    </nav>
  )
}
