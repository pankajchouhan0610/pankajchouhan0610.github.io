---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-labelledby="toc-heading">
      <details class="md:hidden" open>
        <summary id="toc-heading" class="cursor-pointer text-sm font-semibold">
          Table of contents
        </summary>
        <ol class="mt-3 space-y-2 text-sm">
          {items.map((heading) => (
            <li class={heading.depth === 3 ? 'pl-4' : ''}>
              <a class="text-[var(--muted)] hover:text-[var(--ink)]" href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
      <div class="hidden md:block">
        <p id="toc-heading-desktop" class="text-sm font-semibold">
          Table of contents
        </p>
        <ol class="mt-3 space-y-2 text-sm" aria-labelledby="toc-heading-desktop">
          {items.map((heading) => (
            <li class={heading.depth === 3 ? 'pl-4' : ''}>
              <a class="text-[var(--muted)] hover:text-[var(--ink)]" href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}
