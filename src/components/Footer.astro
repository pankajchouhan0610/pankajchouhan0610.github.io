---
import { AUTHOR_NAME, AUTHOR_LINKEDIN, SITE_NAME, SITE_TAGLINE } from '../consts';
import { uniqueCategories } from '../lib/posts';
import type { BlogPost } from '../lib/posts';
import { categoryUrl } from '../lib/urls';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const categories = uniqueCategories(posts);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-[var(--line)]">
  <div class="mx-auto grid max-w-[1080px] gap-10 px-5 py-12 md:grid-cols-[1.4fr_1fr_1fr] md:px-8">
    <div>
      <p class="text-lg font-bold">{SITE_NAME}</p>
      <p class="mt-2 max-w-sm text-sm leading-6 text-[var(--muted)]">{SITE_TAGLINE}</p>
      <p class="mt-3 text-sm text-[var(--muted)]">Written by {AUTHOR_NAME}.</p>
      <p class="mt-3">
        <a
          class="text-sm font-medium text-[var(--ink)] hover:text-[var(--accent)]"
          href={AUTHOR_LINKEDIN}
          target="_blank"
          rel="noopener noreferrer me"
        >
          LinkedIn
        </a>
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-[var(--muted)] hover:text-[var(--ink)]" href="/blog">All articles</a></li>
        <li><a class="text-[var(--muted)] hover:text-[var(--ink)]" href="/about">About</a></li>
        <li><a class="text-[var(--muted)] hover:text-[var(--ink)]" href="/search">Search</a></li>
        <li><a class="text-[var(--muted)] hover:text-[var(--ink)]" href="/rss.xml">RSS</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold">Categories</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          categories.map((category) => (
            <li>
              <a class="text-[var(--muted)] hover:text-[var(--ink)]" href={categoryUrl(category)}>
                {category}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-[var(--line)]">
    <p class="mx-auto max-w-[1080px] px-5 py-5 text-xs text-[var(--muted)] md:px-8">
      © {year} {SITE_NAME}. All rights reserved.
    </p>
  </div>
</footer>
